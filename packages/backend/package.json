{
  "name": "@app/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fullstack App Express backend with Supabase and Stripe",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'),p=require('path'),s=p.resolve(__dirname,'../../config'),d=p.resolve(__dirname,'src/config');['branding.ts','branding.types.ts'].forEach(f=>{try{let c=fs.readFileSync(p.join(s,f),'utf8');if(f==='branding.ts')c=c.replace('./branding.types','./_branding.types');fs.writeFileSync(p.join(d,'_'+f),c)}catch(e){console.warn('Config copy skipped:',f)}})\"",
    "dev": "npm run prebuild && tsx watch src/index.ts",
    "build": "npm run prebuild && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.47.12",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "stripe": "^14.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.0"
  }
}
